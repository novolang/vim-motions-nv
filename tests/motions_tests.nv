fn t770() [io]
    vector("control p\x1ehello world foo\n  bar.baz(qux) end\n\nlast line here\x1e1\x1e4\x1e0\x1e<C-p>\x1e=\x1e0\x1e4\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t771() [io]
    vector("control j\x1ehello world foo\n  bar.baz(qux) end\n\nlast line here\x1e0\x1e4\x1e0\x1e<C-j>\x1e=\x1e1\x1e4\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t772() [io]
    vector("search forward\x1ethe cat sat\non the mat\nthe end\x1e0\x1e0\x1e0\x1e/the<CR>\x1e=\x1e1\x1e3\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t773() [io]
    vector("search forward twice\x1ethe cat sat\non the mat\nthe end\x1e0\x1e0\x1e0\x1e/the<CR>n\x1e=\x1e2\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t774() [io]
    vector("search backward\x1ethe cat sat\non the mat\nthe end\x1e2\x1e5\x1e0\x1e?the<CR>\x1e=\x1e2\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t775() [io]
    vector("search backward then n\x1ethe cat sat\non the mat\nthe end\x1e2\x1e5\x1e0\x1e?the<CR>n\x1e=\x1e1\x1e3\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t776() [io]
    vector("search backward then N\x1ethe cat sat\non the mat\nthe end\x1e2\x1e5\x1e0\x1e?the<CR>N\x1e=\x1e0\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t777() [io]
    vector("search forward then N\x1ethe cat sat\non the mat\nthe end\x1e0\x1e0\x1e0\x1e/at<CR>N\x1e=\x1e1\x1e8\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t778() [io]
    vector("search wraps\x1ethe cat sat\non the mat\nthe end\x1e2\x1e5\x1e0\x1e/cat<CR>\x1e=\x1e0\x1e4\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t779() [io]
    vector("search with a count\x1ethe cat sat\non the mat\nthe end\x1e0\x1e0\x1e0\x1e2/the<CR>\x1e=\x1e2\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t780() [io]
    vector("search not found\x1ethe cat sat\non the mat\nthe end\x1e0\x1e0\x1e0\x1e/zzz<CR>\x1e=\x1e0\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t781() [io]
    vector("star\x1ethe cat sat\non the mat\nthe end\x1e0\x1e1\x1e0\x1e*\x1e=\x1e1\x1e3\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t782() [io]
    vector("star twice\x1ethe cat sat\non the mat\nthe end\x1e0\x1e1\x1e0\x1e**\x1e=\x1e2\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t783() [io]
    vector("hash\x1ethe cat sat\non the mat\nthe end\x1e2\x1e1\x1e0\x1e#\x1e=\x1e1\x1e3\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t784() [io]
    vector("star on a non-word\x1e  --  the\x1e0\x1e0\x1e0\x1e*\x1e=\x1e0\x1e6\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")

@test
fn t785() [io]
    vector("star count\x1ethe cat sat\non the mat\nthe end\x1e0\x1e1\x1e0\x1e2*\x1e=\x1e2\x1e0\x1e0\x1e-1\x1e-1\x1e-1\x1e\x1e")
