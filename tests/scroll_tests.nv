// scroll_tests.nv — vectors checked against a real editor.
//
// Generated by tests/oracle/gen.lua from tests/oracle/scroll.lua.  Each
// case types keys against a text and compares the lines, the cursor, the
// mode, the Visual anchor, the first line shown and the registers with
// what the editor produced for the same keys.  A case is one string of
// fields; a cursor of -1 is not compared.

use std.test
use std.list
use std.str
use vimmodal
use vimstep
use vimram

fn num(s: Str) -> Int
    str.to_int(s) ?? 0

// text_of reads the lines of a text.  "#n" is n lines of the form "  line 1".
fn text_of(s: Str) -> [Str]
    if str.starts_with(s, "#")
        var out: [Str] = []
        for i in 1..=num(str.slice(s, 1, str.len(s)))
            list.push(out, "  line ${i}")
        return out
    str.split(s, "\n")

fn vector(spec: Str) [io]
    let f = str.split(spec, "\x1e")
    test.case(f[0])
    let text = text_of(f[1])
    var d = vimram.doc_new(text, 22)
    d.top = num(f[4])
    var m = vimmodal.modal_new()
    m = vimstep.set_cursor(m, d, num(f[2]), num(f[3]))
    m = vimram.run(var d, m, f[5])
    let wl = num(f[7])
    let wanl = num(f[10])
    let wtop = num(f[12])
    let names = ['"', '0', '1', '-', 'a', 'b']
    var gt: [Str] = []
    var gw: [Bool] = []
    for n in names
        list.push(gt, m.reg_text(n))
        list.push(gw, m.reg_is_linewise(n))
    let ls = vimram.doc_lines(d)
    let want = if f[6] == "="
        text
    else
        text_of(f[6])
    let same = ls == want
    var rt = str.split(f[13], "\x1f")
    var rl: [Bool] = []
    for ch in str.chars(f[14])
        list.push(rl, ch == "t")
    if f[13] == ""
        rt = ["", "", "", "", "", ""]
        rl = [false, false, false, false, false, false]
    let got = summary((if same then ["="] else ls),
        (if wl >= 0 then m.line else -1),
        (if wl >= 0 then m.col else -1),
        m.mode,
        (if wanl >= 0 then m.anchor_line else -1),
        (if wanl >= 0 then m.anchor_col else -1),
        (if wtop >= 0 then d.top else -1),
        gt,
        gw)
    let exp = summary((if same then ["="] else want), wl, num(f[8]), num(f[9]), wanl, num(f[11]), wtop, rt, rl)
    test.assert_eq_str(got, exp)

fn summary(lines: [Str], l: Int, c: Int, mode: Int, anl: Int, anc: Int, top: Int, rt: [Str],
           rl: [Bool]) -> Str
    var s = "lines=${lines} cursor=${l},${c} mode=${mode} anchor=${anl},${anc} top=${top} registers="
    for i in 0..list.len(rt)
        s = s + "[${rt[i]}:${rl[i]}]"
    s

@test
fn t1() [io]
    vector("scroll <C-e> cursor 0 top 0\x1e#100\x1e0\x1e0\x1e0\x1e<C-e>\x1e=\x1e1\x1e0\x1e0\x1e-1\x1e-1\x1e1\x1e\x1e")

